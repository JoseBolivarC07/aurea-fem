<%#
  ══════════════════════════════════════════════════════════════════════════
  VISTA: PRODUCTOS
  ══════════════════════════════════════════════════════════════════════════

  Cuatro secciones:
    1. Encabezado → titular y presentación
    2. Catálogo   → rejilla de productos con su foto
    3. Aviso      → advertencia sanitaria sobre el uso de los productos
    4. Llamado    → invitación a consultarle a Aura

  Estilos exclusivos: `/css/views/productos.css`
#%>
<%- include('partials/encabezado-pagina', {
      paginaEtiqueta: 'Productos',
      paginaTitulo: 'Bienestar seleccionado, no improvisado',
      paginaTexto: 'Calor, calma y cuidado para los días en que el cuerpo más se siente. Cada referencia se revisa antes de entrar al catálogo.'
    }) %>


<section class="catalogo">
  <div class="contenedor">

    <div class="catalogo__rejilla">
      <% productos.forEach(function (producto, indice) { %>
      <article class="producto" data-revelar style="--retardo: <%= indice % 4 %>">

        <div class="producto__figura">
          <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>"
               width="800" height="600" loading="lazy" decoding="async">
        </div>

        <div class="producto__cuerpo">
          <p class="producto__formato"><%= producto.formato %></p>
          <h2 class="producto__titulo"><%= producto.nombre %></h2>
          <p class="producto__resumen"><%= producto.resumen %></p>
          <p class="producto__detalle"><%= producto.detalle %></p>

          <% if (producto.etapas.length > 0) { %>
          <ul class="producto__etapas">
            <% producto.etapas.forEach(function (etapaId) {
                 const etapa = etapas.find(function (e) { return e.id === etapaId; }); %>
            <li class="marca-etapa"><%= etapa ? etapa.nombre : etapaId %></li>
            <% }); %>
          </ul>
          <% } %>
        </div>

        <footer class="producto__pie">
          <span class="producto__precio"><%= producto.precioFormateado %></span>
          <button class="boton boton--contorno boton--compacto" type="button"
                  data-consultar-producto="<%= producto.nombre %>">
            Consultar
          </button>
        </footer>

      </article>
      <% }); %>
    </div>

  </div>
</section>


<section class="aviso-catalogo">
  <div class="contenedor aviso-catalogo__interior" data-revelar>
    <svg class="icono" aria-hidden="true"><use href="#i-escudo"></use></svg>
    <p>
      Los productos de Áurea Fem acompañan el bienestar, pero no reemplazan un
      tratamiento médico. Si un síntoma persiste o se intensifica, consulta con
      una profesional de la salud.
    </p>
  </div>
</section>


<section class="llamado llamado--sobrio">
  <div class="contenedor llamado__interior" data-revelar>
    <h2 class="llamado__titulo">¿No sabes cuál te conviene?</h2>
    <p class="llamado__texto">
      Cuéntale a Aura qué estás sintiendo y en qué etapa estás. Te orienta sobre
      lo que puede ayudarte, sin venderte de más.
    </p>
    <div class="llamado__acciones">
      <button class="boton boton--claro" type="button" data-abrir-chat>
        <svg class="icono" aria-hidden="true"><use href="#i-chat"></use></svg>
        Preguntarle a Aura
      </button>
    </div>
  </div>
</section>
